#!/bin/sh
# Notifies what needs to know that an application was installed. The desktop's
# index of .desktop files is the only one: GNOME Shell reads the search
# provider's file at startup and keeps no cache of its own.
set -e

if [ "$1" = "configure" ]; then
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database -q /usr/share/applications || true
    fi
fi

exit 0
