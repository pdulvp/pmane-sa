#!/bin/sh
# Updates the same index after removal.
#
# Nothing here touches any user's home directory. "Start when you log in"
# writes ~/.config/autostart/pmane-sa.desktop for the user who enabled it, and
# a package has no business removing files from users' homes, nor any way to do
# so for a user who is not logged in. An entry left behind names a program that
# is no longer installed, which a session ignores.
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database -q /usr/share/applications || true
    fi
fi

exit 0
