#!/bin/sh
# The same index, told that it went.
#
# Nothing here touches anyone's home directory. "Start when you log in"
# writes ~/.config/autostart/pmane-sans-ame.desktop for the user who asked
# for it, and a package removing files from users' homes is both outside
# what it was given and unable to do it for anyone not logged in. An entry
# left behind names a program that is no longer there, which a session
# passes over.
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database -q /usr/share/applications || true
    fi
fi

exit 0
