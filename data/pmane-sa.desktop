[Desktop Entry]
Type=Application
Name=Program Manager
GenericName=Program Manager
Comment=Another Program Manager for Linux
Exec=pmane-sa
Icon=user-desktop
Terminal=false
Categories=System;
Keywords=program;manager;groups;launcher;
# Matched against a window's WM_CLASS under X11 or XWayland. On Wayland the
# app_id set by setDesktopFileName() is matched instead, against this file's
# name.
StartupWMClass=pmane-sa
