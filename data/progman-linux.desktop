[Desktop Entry]
Type=Application
Name=Program Manager
GenericName=Program Manager
Comment=A Windows 3.1 Program Manager for Linux
Exec=progman-linux
Icon=user-desktop
Terminal=false
Categories=System;
Keywords=progman;program;manager;groups;launcher;
# Matched against a window's WM_CLASS when running under X11 or XWayland.
# On Wayland the app_id set by setDesktopFileName() is what matches instead,
# and it matches this file by its name.
StartupWMClass=progman-linux
