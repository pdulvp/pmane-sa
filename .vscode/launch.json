{
    // Everything that can be run for this project, collected in the Run and
    // Debug list so it is one dropdown and F5 rather than two menus.
    //
    // The first two start the program under gdb. The rest run commands in a
    // terminal: "node-terminal" is how VS Code's launcher runs one, and the
    // commands are shell, not JavaScript.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Program Manager",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/pmane-sa",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Print containers and strings as what they hold",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build"
        },
        {
            // A separate screen, so testing does not touch the desktop in use.
            "name": "Program Manager (on a named screen)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/pmane-sa",
            "args": ["--screen", "Test"],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "Build"
        },
        {
            "name": "Build",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "command": "cmake -S . -B build && cmake --build build --parallel"
        },
        {
            "name": "Package (.deb)",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "command": "cmake -S . -B build && cmake --build build --target deb && ls -la build/*.deb"
        },
        {
            // Incrementing one part resets the parts below it to zero. The next
            // build picks up the new number.
            "name": "Bump major",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "command": "cmake -DFILE=VERSION -DPART=major -P cmake/BumpVersion.cmake"
        },
        {
            "name": "Bump minor",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "command": "cmake -DFILE=VERSION -DPART=minor -P cmake/BumpVersion.cmake"
        },
        {
            "name": "Bump micro",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "command": "cmake -DFILE=VERSION -DPART=patch -P cmake/BumpVersion.cmake"
        }
    ]
}
