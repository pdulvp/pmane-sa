{
    // The tasks available for this project from the editor. Each one runs the
    // same command that would be typed in a terminal, so nothing here depends
    // on editor-specific knowledge.
    "version": "2.0.0",
    "tasks": [
        {
            // Writes the build files. Rarely needed by hand: a build reruns it
            // whenever CMakeLists.txt or VERSION changes.
            "label": "Configure",
            "type": "shell",
            "command": "cmake",
            "args": ["-S", "${workspaceFolder}", "-B", "${workspaceFolder}/build"],
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build", "--parallel"],
            "dependsOn": ["Configure"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "detail": "Compiles, and stamps the binary with the moment it was made"
        },
        {
            "label": "Package (.deb)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build", "--target", "deb"],
            "dependsOn": ["Configure"],
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Builds, then packs build/pmane-sa_<version>-<build>_<arch>.deb"
        },
        {
            // The three parts of the version, one task each. Incrementing one
            // resets the parts below it to zero; the next build picks up the
            // new number.
            "label": "Bump major",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-DFILE=${workspaceFolder}/VERSION",
                "-DPART=major",
                "-P", "${workspaceFolder}/cmake/BumpVersion.cmake"
            ],
            "problemMatcher": [],
            "detail": "1.1.0 -> 2.0.0"
        },
        {
            "label": "Bump minor",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-DFILE=${workspaceFolder}/VERSION",
                "-DPART=minor",
                "-P", "${workspaceFolder}/cmake/BumpVersion.cmake"
            ],
            "problemMatcher": [],
            "detail": "1.1.0 -> 1.2.0"
        },
        {
            "label": "Bump micro",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-DFILE=${workspaceFolder}/VERSION",
                "-DPART=patch",
                "-P", "${workspaceFolder}/cmake/BumpVersion.cmake"
            ],
            "problemMatcher": [],
            "detail": "1.1.0 -> 1.1.1"
        }
    ]
}
